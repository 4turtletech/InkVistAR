# Runtime mode
APP_ENV=development

# Database (Railway MySQL also supplies MYSQLHOST/MYSQLUSER/etc.)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=inkvistar
DB_PORT=3306

# Required in production
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.3
RECAPTCHA_MOBILE_MIN_SCORE=0.1
RECAPTCHA_ALLOWED_HOSTNAMES=www.inkvictusstudio.com,inkvictusstudio.com,inkvistar-web.vercel.app
PAYMONGO_WEBHOOK_SECRET=

# Authentication (required in production; use a cryptographically random value of 32+ characters)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SAME_SITE=lax

# One-time initial administrator switch. Turn off and remove the password after success.
BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Development/staging-only demo accounts. Never enable in production.
SEED_DEMO_ACCOUNTS=false
DEMO_ACCOUNT_PASSWORD=

# Development-only diagnostics
ENABLE_DEBUG_ROUTES=false
CAPTCHA_BYPASS=false
